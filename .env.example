# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Database Connection Pool
DB_POOL_MAX=40
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# Vector Database Configuration (Optional, defaults to regular DB if not set)
# Use these if you want to use a separate PostgreSQL instance for your vectors.
# VECTOR_DB_HOST=localhost
# VECTOR_DB_PORT=5432
# VECTOR_DB_USER=postgres
# VECTOR_DB_PASSWORD=postgres
# VECTOR_DB_NAME=postgres

# Redis Cache Configuration (Optional, improves search performance)
# If not configured, caching is disabled gracefully.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# S3 Storage Configuration (Optional, uses local filesystem if not configured)
# Compatible with AWS S3, MinIO, and other S3-compatible services.
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=rag-files
# S3_REGION=us-east-1

# AI Integration
# Configuration is managed via the Admin UI.

# Authentication
JWT_SECRET=change-me-to-at-least-32-characters

# AUTH_PROVIDER_SECRET_KEY: base64-encoded 32-byte key that wraps OIDC
# client_secret values at rest (auth_providers.config JSONB).
# Generate with: openssl rand -base64 32
# Intentionally env-only (no UI/DB fallback) so a DB-only leak does not also
# yield the plaintext client_secret. Required once any OIDC provider row
# exists; LDAP-only deployments can leave this unset.
AUTH_PROVIDER_SECRET_KEY=

# Default User Passwords (used during seeding)
ADMIN_PASSWORD=admin
# If TESTER_PASSWORD is left empty, the tester user will not be able to log in.
TESTER_PASSWORD=password

# Rate Limiting (values in ms for window, count for max)
# Optimized for ~5k users and University NATs (high shared IP traffic)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
UPLOAD_LIMIT_WINDOW_MS=900000
UPLOAD_LIMIT_MAX=500
GENERATE_LIMIT_WINDOW_MS=900000
GENERATE_LIMIT_MAX=100
CRAWL_LIMIT_WINDOW_MS=3600000
CRAWL_LIMIT_MAX=50
SEARCH_LIMIT_WINDOW_MS=900000
SEARCH_LIMIT_MAX=100

# Web Content Extraction
# WEB_FETCH_CONCURRENCY=4          # Max concurrent extraction instances (default: 4)
# PLAYWRIGHT_FALLBACK=true         # Enable Playwright browser fallback for JS-rendered pages (requires chromium)
# MAX_CONCURRENT_BROWSERS=2        # Max concurrent Playwright browser pages (default: 2)
LOGIN_LIMIT_WINDOW_MS=900000
LOGIN_LIMIT_MAX=100

# Server
PORT=3001
NODE_ENV=development

# Content-Security-Policy override (optional)
# The built-in CSP whitelists a specific sha256 inline-script hash matching the
# Vite production build. If the frontend bundle changes that inline content the
# hash drifts and enforcing browsers silently refuse to execute the script —
# there is no server-side error. Set CSP_HEADER to a full CSP string to patch a
# stale hash (or temporarily relax the policy) without rebuilding the backend.
# CSP_HEADER=default-src 'self'; script-src 'self' 'sha256-...='; style-src 'self' 'unsafe-inline'; frame-src 'self' blob:; media-src 'self' blob:

# Verbose access logging (optional)
# By default the access log suppresses health checks and high-frequency
# frontend polling endpoints (/api/kb/{id}/files, /chats, ...), which would
# otherwise emit ~20 lines/sec per open KB tab. Set LOG_VERBOSE=true during
# incident investigation to log every request, then unset it.
# LOG_VERBOSE=true

# File Processing Memory Management
# Controls concurrent large file processing to prevent OOM crashes.
# Memory requirements: 512MB + (MAX_CONCURRENT × 200MB) minimum
# For containers with limited RAM, reduce MAX_CONCURRENT_LARGE_FILES to 1.
# FILE_PROCESSING_MAX_CONCURRENT_LARGE_FILES=2
# FILE_PROCESSING_LARGE_FILE_THRESHOLD_MB=50
# FILE_PROCESSING_STREAM_CHUNK_SIZE_KB=64
# FILE_PROCESSING_HIGH_WATER_MARK_KB=16

# PDF OCR Fallback
# Set to "false" to disable OCR for scanned PDFs. Requires tesseract + pdftoppm.
# PARSER_ENABLE_OCR=true

# Embedding Cache TTL (default: 7 days as Go duration)
# Redis-backed cache for embedding vectors to reduce API calls.
# EMBEDDING_CACHE_TTL=168h

# Go runtime tuning
#
# GOMEMLIMIT — soft target for total Go heap usage. Without it, Go's GC
# targets ~2× live heap which can overshoot under spikes. Set to ~75% of the
# container memory limit (or available process budget) so the GC paces
# aggressively before the kernel kills the container. Format: "768MiB",
# "2GiB", "off" (disable).
#   GOMEMLIMIT=768MiB
#
# GOGC — heap growth before next GC cycle (% of live heap). Default 100.
# Keep the default; GOMEMLIMIT does the real work under memory pressure.
#   GOGC=100
#
# Pprof profile-sampling rates (only effective when PPROF_ENABLED=true).
# Default 0 = off, so an always-on pprof endpoint pays no overhead.
# Bump for targeted profiling sessions; revert when done.
#   PPROF_MUTEX_PROFILE_FRACTION=5   # 1-in-5 mutex contention samples
#   PPROF_BLOCK_PROFILE_RATE=1000    # sample blocking events ≥ 1µs


# --- Docling (optional layout-aware parsing + image captioning) ---
# Enable + configure in the admin Agent panel (docling_enabled, docling_base_url,
# docling_picture_description_enabled, ...). Image captioning calls your model
# API using the SAME endpoint + API key as the rest of the app (admin AI provider
# config) and the describe_image_model vision model — nothing is set here.
# Optionally raise the Docling convert timeout (default 300s) when captioning is on:
# DOCLING_TIMEOUT_SECONDS=600
