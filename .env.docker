# Database Configuration (Standard PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rag_db

# Vector Database Configuration (PostgreSQL + pgvector 0.8.0)
VECTOR_DB_HOST=vectordb
VECTOR_DB_PORT=5432
VECTOR_DB_USER=postgres
VECTOR_DB_PASSWORD=postgres
VECTOR_DB_NAME=rag_vector_db

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# S3 Storage Configuration (MinIO)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-files
S3_REGION=us-east-1

# AI Integration
# Configuration is managed via the Admin UI.

# Authentication
# REQUIRED: Generate a secure secret (at least 32 chars): node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Default User Passwords (used during seeding)
# REQUIRED: Change this before first deployment
ADMIN_PASSWORD=

WORKER_CONCURRENCY_HEAVY=4
# Server
PORT=3001
NODE_ENV=production
SKIP_MAIN_DB_MIGRATION=false

DISABLE_WORKER=false
WORKER_QUEUES=rag-quick,rag-batch,rag-heavy


# Rate Limiting (values in ms for window, count for max)
# Optimized for ~5k users and University NATs (high shared IP traffic)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
UPLOAD_LIMIT_WINDOW_MS=900000
UPLOAD_LIMIT_MAX=500
GENERATE_LIMIT_WINDOW_MS=900000
GENERATE_LIMIT_MAX=100
CRAWL_LIMIT_WINDOW_MS=3600000
CRAWL_LIMIT_MAX=50
SEARCH_LIMIT_WINDOW_MS=900000
SEARCH_LIMIT_MAX=100
LOGIN_LIMIT_WINDOW_MS=900000
LOGIN_LIMIT_MAX=100

# File Processing Memory Management
# Controls concurrent large file processing to prevent OOM crashes in containers.
# Memory requirements: 512MB + (MAX_CONCURRENT × 200MB) minimum
# Default of 2 requires ~1GB RAM. Reduce to 1 for containers with <1GB limit.
# FILE_PROCESSING_MAX_CONCURRENT_LARGE_FILES=2
# FILE_PROCESSING_LARGE_FILE_THRESHOLD_MB=50