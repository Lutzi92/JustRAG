{
    "name": "JustRAG",
    "version": "1.0.0",
    "description": "A high-performance, self-hosted Retrieval-Augmented Generation (RAG) platform for managing knowledge bases, researching documents, and generating context-aware insights.",
    "main": "index.js",
    "workspaces": [
        "web"
    ],
    "scripts": {
        "server": "npx nodemon --watch src src/server/index.ts",
        "web": "cd web && npm run dev",
        "dev": "npx concurrently \"npm run server\" \"npm run web\"",
        "native:build": "cd native && npm run build",
        "native:build:debug": "cd native && npm run build:debug",
        "build:version": "node -e \"const{execFileSync}=require('child_process');let v;try{v=execFileSync('git',['rev-parse','--short','HEAD']).toString().trim()}catch{v=new Date().toISOString().replace(/\\D/g,'').slice(0,14)}require('fs').writeFileSync('build-info.json',JSON.stringify({version:v,builtAt:new Date().toISOString()}))\"",
        "build": "npm run build:version && npm run native:build && npx tsc && cd web && npm run build",
        "start": "node --expose-gc dist/server/index.js",
        "worker": "node --expose-gc dist/worker/index.js",
        "worker:quick": "node dist/worker/index.js --queue=rag-quick",
        "worker:heavy": "node --expose-gc dist/worker/index.js --queue=rag-heavy",
        "worker:batch": "node --expose-gc dist/worker/index.js --queue=rag-batch",
        "worker:dev": "npx nodemon --watch src src/worker/index.ts",
        "db:seed": "npx tsx src/db/seed.ts",
        "db:seed:prod": "node dist/db/seed.js",
        "db:migrate": "npx tsx src/db/migrate.ts",
        "db:migrate:prod": "node dist/db/migrate.js",
        "migrate:vector": "npx tsx src/scripts/create_vector_tables.ts",
        "migrate:vector:prod": "node dist/scripts/create_vector_tables.js",
        "migrate:generate": "npx tsx src/scripts/generate_dimension_migration.ts",
        "migrate:validate": "npx tsx src/scripts/validate_dimension_sync.ts",
        "cleanup:vectors": "npx tsx src/scripts/cleanup_orphaned_vectors.ts",
        "test": "vitest && npm test --prefix web",
        "test:env:up": "docker compose -f docker-compose.test.yml up -d",
        "test:env:down": "docker compose -f docker-compose.test.yml down",
        "migrate:test": "DB_HOST=localhost VECTOR_DB_HOST=localhost DB_PORT=5433 VECTOR_DB_PORT=5434 DB_NAME=rag_db_test VECTOR_DB_NAME=rag_vector_db_test DB_USER=test_user DB_PASSWORD=test_password VECTOR_DB_USER=test_vector_user VECTOR_DB_PASSWORD=test_vector_password REDIS_PORT=6380 npx tsx src/db/migrate.ts",
        "migrate:vector:test": "DB_HOST=localhost VECTOR_DB_HOST=localhost DB_PORT=5433 VECTOR_DB_PORT=5434 DB_NAME=rag_db_test VECTOR_DB_NAME=rag_vector_db_test DB_USER=test_user DB_PASSWORD=test_password VECTOR_DB_USER=test_vector_user VECTOR_DB_PASSWORD=test_vector_password REDIS_PORT=6380 npx tsx src/scripts/create_vector_tables.ts",
        "test:setup": "npm run test:env:up && sleep 5 && npm run migrate:test && npm run migrate:vector:test"
    },
    "overrides": {
        "esbuild": "0.27.3",
        "fast-xml-parser": "5.5.6",
        "flatted": "3.4.0",
        "underscore": "1.13.8",
        "yauzl": "3.2.1",
        "minimatch": "10.2.3",
        "serialize-javascript": "7.0.4",
        "file-type": "21.3.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Lutzi92/JustRAG.git"
    },
    "keywords": [
        "rag",
        "retrieval-augmented-generation",
        "knowledge-base",
        "llm",
        "ai",
        "vector-search",
        "pgvector",
        "research-agent",
        "self-hosted",
        "university",
        "academic"
    ],
    "author": "Lutzi92",
    "license": "MIT",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/Lutzi92/JustRAG/issues"
    },
    "homepage": "https://github.com/Lutzi92/JustRAG#readme",
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/bcrypt": "6.0.0",
        "@types/compression": "1.8.1",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/hpp": "^0.2.7",
        "@types/jsdom": "27.0.0",
        "@types/jsonwebtoken": "9.0.10",
        "@types/multer": "2.0.0",
        "@types/node": "25.3.0",
        "@types/pdf-parse": "1.1.5",
        "@types/pg": "8.16.0",
        "@types/supertest": "6.0.3",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/turndown": "5.0.6",
