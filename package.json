        "@aws-sdk/lib-storage": "^3.1011.0",
        "@duckdb/node-api": "1.4.4-r.1",
        "@langchain/core": "1.1.26",
        "@langchain/openai": "1.2.8",
        "@mozilla/readability": "0.6.0",
        "@scalar/express-api-reference": "^0.9.0",
        "axios": "^1.13.5",
        "bcrypt": "6.0.0",
        "bullmq": "5.69.3",
        "compression": "1.8.1",
        "cors": "2.8.6",
        "csv-parser": "3.2.0",
        "defuddle": "^0.14.0",
        "docx": "9.5.3",
        "dotenv": "17.3.1",
        "drizzle-orm": "0.45.1",
        "eslint": "^9.39.2",
        "exceljs": "^4.1.1",
        "express": "5.2.1",
        "express-rate-limit": "^8.3.1",
        "express-static-gzip": "^3.0.0",
        "form-data": "4.0.5",
