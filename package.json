        "js-tiktoken": "1.0.21",
        "jsdom": "28.1.0",
        "jsonwebtoken": "9.0.3",
        "jszip": "3.10.1",
        "ldapts": "8.1.6",
        "linkedom": "^0.18.12",
        "mammoth": "1.11.0",
